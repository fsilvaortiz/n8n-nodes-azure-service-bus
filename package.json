{
	"name": "n8n-nodes-azure-servicebus",
	"version": "1.0.0",
	"description": "n8n community node for Azure Service Bus — send, receive, schedule, peek, batch, and manage queues, topics, and subscriptions with full admin CRUD, dead letter support, and session handling.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"azure",
		"service-bus",
		"queue",
		"topic",
		"messaging"
	],
	"license": "MIT",
	"homepage": "https://github.com/fsilvaortiz/n8n-nodes-azure-service-bus",
	"repository": {
		"type": "git",
		"url": "https://github.com/fsilvaortiz/n8n-nodes-azure-service-bus.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "tsc && copyfiles \"nodes/**/*.svg\" dist/",
		"dev": "tsc --watch",
		"lint": "eslint . --ext .ts",
		"test": "jest",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/AzureServiceBusApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AzureServiceBus/AzureServiceBus.node.js",
			"dist/nodes/AzureServiceBus/AzureServiceBusTrigger.node.js"
		]
	},
	"dependencies": {
		"@azure/service-bus": "^7.9.5",
		"long": "^5.2.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.0",
		"copyfiles": "^2.4.1",
		"jest": "^29.7.0",
		"jest-mock-extended": "^3.0.7",
		"n8n-workflow": "*",
		"ts-jest": "^29.2.5",
		"typescript": "^5.7.0"
	}
}
